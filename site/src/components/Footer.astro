---
import { RELEASES_URL, REPO_URL, asset } from '../lib/site';
---

<footer>
  <div class="footer-row">
    <a class="brand" href={asset('')}>
      <img src={asset('assets/favicon.png')} width="22" height="22" alt="" />
      <span>Feeder</span>
    </a>
    <div class="links">
      <a href={REPO_URL}>Source code</a>
      <a href={RELEASES_URL}>All releases</a>
      <a href={`${REPO_URL}/blob/main/LICENSE`}>MIT License</a>
      <a href={`${REPO_URL}/blob/main/assets/ThirdPartyLicenses.html`}>Third-party licenses</a>
    </div>
  </div>
  <p>
    Claude, Codex, Cursor, Antigravity, T3 Code and OpenCode are trademarks of their owners. Feeder
    isn't affiliated with or endorsed by them.
  </p>
</footer>

<style>
  footer {
    margin-top: 72px;
    padding: 28px 0 48px;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 13.5px;
  }
  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 600;
    font-size: 14.5px;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand img {
    width: 22px;
    height: 22px;
    display: block;
    border-radius: 5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .links a {
    color: var(--text-2);
  }
  .links a:hover {
    color: var(--text);
  }
  p {
    margin: 0;
    line-height: 1.5;
  }
</style>
