<section id="uninstall">
  <div class="uninstall-box">
    <h2>Uninstall</h2>
    <ol class="uninstall-list">
      <li>
        <div>
          Open <strong>Settings → Uninstall</strong> and click{' '}
          <strong>Remove Feeder from all tools</strong> to remove it from every tool's config.
        </div>
      </li>
      <li>
        <div>Quit Feeder and move it from Applications to the Trash.</div>
      </li>
      <li>
        <div>
          To remove your database and screenshots too, delete{' '}
          <code>~/Library/Application Support/feeder</code>.
        </div>
      </li>
    </ol>
  </div>
</section>

