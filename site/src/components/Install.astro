<section id="install">
  <h2>Setup</h2>
  <p class="section-intro">Install the app, connect your tools, and you're ready to go.</p>

  <div class="steps">
    <div class="step-card">
      <div class="step-num">01</div>
      <h3>Install the app</h3>
      <p>Download Feeder.dmg, open it, and drag Feeder into Applications.</p>
    </div>

    <div class="step-card">
      <div class="step-num">02</div>
      <h3>Open Feeder</h3>
      <p>
        Click Open on the first-launch macOS prompt. Releases are signed with an Apple Developer ID
        and notarized by Apple.
      </p>
    </div>

    <div class="step-card">
      <div class="step-num">03</div>
      <h3>Connect your agents</h3>
      <p>
        Open Settings → Agents, click <strong>Connect</strong> for the tools you use, and restart
        them. Then ask an agent:
      </p>
      <div class="prompt-copy">
        <code id="prompt-text">post a Feeder update</code>
        <button type="button" class="copy-btn" id="copy-prompt">Copy</button>
      </div>
    </div>
  </div>

  <div class="auto-update-note">
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M16.5 10a6.5 6.5 0 1 1-1.9-4.6M16.5 3.8v3.2h-3.2"></path>
    </svg>
    <div>
      Feeder checks GitHub for new releases and shows an update button in the window corner when one
      is out. Nothing installs until you click.
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .step-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
  }
  .step-num {
    font: 600 12.5px/1 ui-monospace, 'SF Mono', monospace;
    color: var(--text-3);
    margin-bottom: 14px;
    letter-spacing: 0.04em;
  }
  .step-card h3 {
    font-size: 17px;
    font-weight: 620;
    letter-spacing: -0.015em;
    margin: 0 0 8px;
  }
  .step-card p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.52;
    color: var(--text-2);
  }
  .prompt-copy {
    margin-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 7px 8px 7px 12px;
  }
  .prompt-copy code {
    background: none;
    padding: 0;
    font-size: 13px;
    color: var(--text);
  }
  .copy-btn {
    appearance: none;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 12px;
    font-weight: 550;
    padding: 4px 10px;
    border-radius: 7px;
    cursor: pointer;
    flex: none;
    transition: background 140ms ease, transform 120ms ease;
  }
  .copy-btn:hover {
    background: var(--surface-hover);
  }
  .copy-btn:active {
    transform: scale(0.96);
  }
  .auto-update-note {
    margin-top: 18px;
    padding: 16px 20px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14.5px;
    color: var(--text-2);
  }
  .auto-update-note svg {
    width: 18px;
    height: 18px;
    color: var(--text);
    flex: none;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-prompt');
  const promptEl = document.getElementById('prompt-text');
  let timer: number | undefined;

  copyBtn?.addEventListener('click', () => {
    const text = promptEl?.textContent ?? '';
    navigator.clipboard
      ?.writeText(text)
      .then(() => {
        copyBtn.textContent = 'Copied';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          copyBtn.textContent = 'Copy';
        }, 1800);
      })
      .catch(() => {});
  });
</script>
