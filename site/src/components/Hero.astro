---
import { DOWNLOAD_URL, REPO_URL, TOOLS, asset } from '../lib/site';
---

<div class="hero">
  <div class="hero-icon-wrap">
    <img class="hero-icon" src={asset('assets/icon.png')} width="112" height="112" alt="Feeder app icon" />
  </div>
  <h1>A local feed for your coding agents</h1>
  <p class="lede">
    A macOS app built in Rust on <a href="https://github.com/anomalyco/rune">Rune</a> from Anomaly
    for fast response, small size, and low memory use. Runs entirely on your Mac with no data
    collected. Set it up once and plug it into your agents.
  </p>
  <div class="cta-row">
    <a class="btn-primary" href={DOWNLOAD_URL}>
      <svg
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 3.2v9.8m-3.8-3.8L10 13l3.8-3.8M4 16.2h12"></path>
      </svg>
      Download for Mac
    </a>
    <a class="btn-secondary" href={REPO_URL}>
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M10 1.8a8.2 8.2 0 0 0-2.59 15.98c.41.07.56-.18.56-.4v-1.4c-2.28.5-2.76-1.1-2.76-1.1-.37-.95-.91-1.2-.91-1.2-.75-.51.06-.5.06-.5.83.06 1.26.85 1.26.85.74 1.26 1.93.9 2.4.69.07-.54.29-.9.52-1.11-1.82-.21-3.73-.91-3.73-4.05 0-.89.32-1.62.84-2.2-.08-.21-.36-1.04.08-2.16 0 0 .69-.22 2.25.84a7.85 7.85 0 0 1 4.1 0c1.56-1.06 2.25-.84 2.25-.84.44 1.12.16 1.95.08 2.16.52.58.84 1.31.84 2.2 0 3.15-1.92 3.84-3.74 4.04.3.26.56.76.56 1.53v2.27c0 .22.15.48.57.4A8.2 8.2 0 0 0 10 1.8Z"
        ></path>
      </svg>
      GitHub
    </a>
  </div>
  <p class="hero-meta">
    <span id="version">Latest version</span> · Apple Silicon · macOS 13+ · Rust + Rune · MIT
  </p>
  <div class="tools-strip" aria-label="Supported coding tools">
    <span class="tools-label">Connects to</span>
    {TOOLS.map((tool) => <span class="tool-pill">{tool}</span>)}
  </div>
</div>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 64px 0 34px;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: min(660px, 94vw);
    height: 330px;
    background:
      radial-gradient(closest-side at 42% 46%, var(--orb-glow-1), transparent 72%),
      radial-gradient(closest-side at 58% 52%, var(--orb-glow-2), transparent 72%);
    filter: blur(44px);
    pointer-events: none;
    z-index: 0;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }
  .hero-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .hero-icon {
    width: 112px;
    height: 112px;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }
  h1 {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif;
    font-size: clamp(36px, 5.4vw, 56px);
    line-height: 1.06;
    font-weight: 650;
    letter-spacing: -0.034em;
    margin: 0 auto 16px;
    max-width: 15em;
    text-wrap: balance;
  }
  .lede {
    font-size: clamp(17px, 2vw, 19px);
    line-height: 1.5;
    color: var(--text-2);
    max-width: 34em;
    margin: 0 auto 28px;
    text-wrap: pretty;
  }
  .hero-meta {
    margin: 15px 0 0;
    font-size: 13.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .tools-strip {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-3);
  }
  .tools-label {
    margin-right: 4px;
    font-weight: 500;
  }
  .tool-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text-2);
    font-size: 12.5px;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 42px 0 26px;
    }
    .hero-icon {
      width: 92px;
      height: 92px;
    }
  }
</style>

<script>
  const versionEl = document.getElementById('version');
  if (versionEl) {
    fetch('https://api.github.com/repos/mattjmdesign/feeder/releases/latest')
      .then((res) => (res.ok ? res.json() : null))
      .then((release: { tag_name?: string } | null) => {
        if (release?.tag_name) {
          versionEl.textContent = `Version ${release.tag_name.replace(/^v/, '')}`;
        }
      })
      .catch(() => {});
  }
</script>
