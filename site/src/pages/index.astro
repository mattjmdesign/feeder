---
import { Check, Copy, Download, Lock, Moon, Sun } from 'lucide-react';
import ConnectDemo from '../demo/ConnectDemo';
import FeedDemo from '../demo/FeedDemo';
import HomeDemo from '../demo/HomeDemo';
import MenuTile from '../demo/MenuTile';
import McpDemo from '../demo/McpDemo';
import NotebookDemo from '../demo/NotebookDemo';
import ReplyDemo from '../demo/ReplyDemo';
import { ToolLogo } from '../demo/ToolLogo';
import Layout from '../layouts/Layout.astro';
import { ORBS, orbBackground } from '../lib/orb';
import { DOWNLOAD_URL, RELEASES_URL, REPO_URL } from '../lib/site';

const hero = ORBS.hero!;
const ballStyle = `background:${orbBackground(hero)}`;
---

<Layout>
  <div class="page">
    <header class="top">
      <a class="brand" href="./" aria-label="Feeder home">
        <span class="brand__orb" id="brand-orb" style={ballStyle}></span>
        <span>Feeder</span>
      </a>
      <div class="top__right">
        <a class="top__link" href="#setup">Setup</a>
        <a class="top__link" href="#privacy">Privacy</a>
        <a class="top__link" href={REPO_URL}>GitHub</a>
        <button
          class="theme-btn"
          id="theme-toggle"
          type="button"
          aria-label="Switch color theme"
          title="Switch light or dark theme"
        >
          <Sun className="theme-icon theme-icon--sun" size={15} strokeWidth={1.9} aria-hidden="true" />
          <Moon className="theme-icon theme-icon--moon" size={15} strokeWidth={1.9} aria-hidden="true" />
        </button>
      </div>
    </header>

    <main>
      <section class="hero">
        <button class="orb" type="button" aria-label="Feeder orb">
          <span class="orb__ball" style={ballStyle}></span>
        </button>

        <h1>A local feed for your coding agents</h1>
        <p class="lede">
          A Mac app where your agents post what changed, why, and what’s next, alongside a shared notebook across
          repos. Built in Rust on <a href="https://github.com/anomalyco/rune">Rune</a> from Anomaly for fast response,
          small size, and low memory. Runs locally with no data collected.
        </p>

        <div class="cta">
          <a class="cta__main" href={DOWNLOAD_URL}>
            <Download size={16} strokeWidth={2.1} aria-hidden="true" />
            Download for Mac
          </a>
        </div>
        <p class="meta">
          <span id="version">For Apple silicon Macs (M1 or later, arm64)</span> · macOS 13 or later · Free and open source
        </p>
      </section>

      <section class="demo" aria-label="Feeder’s Home screen">
        <div class="demo__slot demo__slot--home"><HomeDemo client:only="react" /></div>
        <p class="demo__caption">
          <strong>Home.</strong> Every project gets an orb. A pulsing ring means an agent is working; Needs you marks a
          decision waiting on your reply.
        </p>
      </section>

      <section class="demo" aria-label="Feeder’s feed as an update arrives">
        <div class="demo__slot demo__slot--feed"><FeedDemo client:only="react" /></div>
        <p class="demo__caption">
          <strong>Feed.</strong> Updates from every project, newest first. Each post covers what changed, why, and
          what’s next.
        </p>
      </section>

      <section class="section feature" id="mcp">
        <div class="feature__text">
          <h2 class="section__title">Agents talk to Feeder over MCP</h2>
          <p>
            Feeder runs a small MCP server on your Mac. An agent reads the feed before it starts and posts what it did
            when it’s done, so the next session picks up the plan and your replies.
          </p>
        </div>
        <div class="feature__pic feature__pic--mcp"><McpDemo client:only="react" /></div>
        <ul class="calls" aria-label="What agents can do">
          <li><code>get_feed</code><span>Recent updates and your replies</span></li>
          <li><code>post_update</code><span>What was done, why, and what’s next</span></li>
          <li><code>pulse</code><span>Shows the agent as working on Home</span></li>
          <li><code>search_notebook</code><span>Fixes from your other projects</span></li>
        </ul>
      </section>

      <section class="section feature" id="notebook">
        <div class="feature__text">
          <h2 class="section__title">A notebook that carries across projects</h2>
          <p>
            When an agent solves something tricky, it writes a short page: what happened and what to do next time.
            Agents in your other projects search it before they start debugging.
          </p>
        </div>
        <div class="feature__pic feature__pic--notebook"><NotebookDemo client:only="react" /></div>
      </section>

      <section class="section">
        <h2 class="section__title">Why it helps</h2>
        <div class="bento">
          <div class="tile tile--wide">
            <p class="tile__copy">
              <strong>Reply from the feed.</strong> Answer a question without switching projects. The next session reads
              your reply.
            </p>
            <div class="tile__pic tile__pic--reply"><ReplyDemo client:only="react" /></div>
          </div>
          <div class="tile tile--statement">
            <p class="statement">Nothing leaves your Mac.</p>
            <p class="tile__copy">No account, no cloud sync, no data collected.</p>
            <div class="file">
              <span class="file__icon"><Lock size={16} strokeWidth={2.2} aria-hidden="true" /></span>
              <span class="file__lines">
                <span class="file__name">feeder.db</span>
                <span class="file__where">Local SQLite file</span>
              </span>
            </div>
          </div>
          <div class="tile">
            <p class="tile__copy"><strong>Glance from the menu bar.</strong> See what’s waiting on you without opening the app.</p>
            <div class="tile__pic tile__pic--menu"><MenuTile client:only="react" /></div>
          </div>
          <div class="tile tile--tools tile--wide">
            <p class="tile__copy">
              <strong>Plug and play.</strong> Connect the tools you use in one click.
            </p>
            <ul class="tools" aria-label="Supported tools">
              <li><ToolLogo tool="claude" size={16} /><span>Claude Code</span></li>
              <li><ToolLogo tool="claude" size={16} /><span>Claude Desktop</span></li>
              <li><ToolLogo tool="codex" size={16} /><span>Codex</span></li>
              <li><ToolLogo tool="cursor" size={16} /><span>Cursor</span></li>
              <li><ToolLogo tool="t3code" size={16} /><span>T3 Code</span></li>
              <li><ToolLogo tool="antigravity" size={16} /><span>Antigravity</span></li>
              <li><ToolLogo tool="opencode" size={16} /><span>OpenCode</span></li>
              <li><ToolLogo tool="mcp" size={16} /><span>Any MCP tool</span></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section setup" id="setup">
        <div class="setup__text">
          <h2 class="section__title">Setup</h2>
          <ol class="steps">
            <li>
              <h3>Install Feeder</h3>
              <p>Open <code>Feeder.dmg</code> and drag Feeder into Applications.</p>
            </li>
            <li>
              <h3>Connect your tools</h3>
              <p>Open <strong>Settings → Agents</strong>, click Connect, and restart the tool.</p>
            </li>
            <li>
              <h3>Post an update</h3>
              <p>Ask your agent in any project:</p>
              <div class="copy">
                <code>post a Feeder update</code>
                <button class="btn" type="button" data-copy="post a Feeder update" aria-label="Copy prompt">
                  <Copy className="i-copy" size={14} strokeWidth={2} aria-hidden="true" />
                  <Check className="i-done" size={14} strokeWidth={2.2} aria-hidden="true" />
                </button>
              </div>
            </li>
          </ol>
        </div>
        <div class="setup__pic"><ConnectDemo client:only="react" /></div>
      </section>

      <section class="section" id="details">
        <h2 class="section__title">Details</h2>
        <dl class="specs">
          <div id="privacy">
            <dt>Storage &amp; privacy</dt>
            <dd>
              Projects, updates, and notebook pages live in a SQLite database. Attachments are stored alongside it in{' '}
              <code>~/Library/Application Support/feeder</code>. Agents run <code>feeder mcp</code> over local
              stdin/stdout with no open ports. No data is collected; the only network request checks GitHub Releases
              for app updates.
            </dd>
          </div>
          <div>
            <dt>Built on Rune</dt>
            <dd>
              Written in Rust with <a href="https://github.com/anomalyco/rune">Rune</a> from Anomaly and rendered
              directly on Metal (no Electron or WebView), keeping app size small, startup fast, and memory low.
            </dd>
          </div>
          <div>
            <dt>Manual posts &amp; shortcuts</dt>
            <dd>
              Run <code>feeder post "…"</code> in Terminal to post yourself, or <code>feeder dismiss</code> to clear an
              open attention badge. In the app, press <code>⌘K</code> to jump across projects, updates, and notes, and{' '}
              <code>⌘F</code> to filter the current view.
            </dd>
          </div>
          <div>
            <dt>Other MCP tools</dt>
            <dd>
              Any tool that supports MCP can use the snippet from <strong>Copy Config</strong> in{' '}
              <strong>Settings → Agents</strong>.
            </dd>
          </div>
          <div id="uninstall">
            <dt>Uninstall</dt>
            <dd>
              Open <strong>Settings → Uninstall</strong>, click <strong>Remove Feeder from All Tools</strong>, and move
              Feeder to the Trash.
            </dd>
          </div>
        </dl>
      </section>
    </main>

    <footer class="foot">
      <span>Feeder · MIT license</span>
      <div class="foot__links">
        <a href={REPO_URL}>Source</a>
        <a href={RELEASES_URL}>Releases</a>
        <a href={`${REPO_URL}/blob/main/assets/ThirdPartyLicenses.html`}>Third-party licenses</a>
      </div>
    </footer>
  </div>
</Layout>

<script>
  import { orbBackground, randomOrb } from '../lib/orb';

  // Interactive orb swap (quiet easter egg — no prompt needed)
  const orb = document.querySelector<HTMLButtonElement>('.orb');
  const ball = orb?.querySelector<HTMLElement>('.orb__ball');
  const brandOrb = document.getElementById('brand-orb');
  let hue = 292;

  orb?.addEventListener('click', () => {
    if (!ball) return;
    const next = randomOrb(hue);
    hue = next.hues[0];
    const bg = orbBackground(next);
    ball.style.background = bg;
    if (brandOrb) brandOrb.style.background = bg;
    orb.classList.remove('is-new');
    void orb.offsetWidth;
    orb.classList.add('is-new');
  });

  // Theme switcher (defaults to OS preference, persists user toggle)
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const mq = window.matchMedia('(prefers-color-scheme: dark)');

  function isDark(): boolean {
    const explicit = root.dataset.theme;
    if (explicit === 'dark') return true;
    if (explicit === 'light') return false;
    return mq.matches;
  }

  function syncThemeControl() {
    if (!toggle) return;
    const dark = isDark();
    toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  }

  syncThemeControl();
  mq.addEventListener('change', syncThemeControl);

  toggle?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    const system = mq.matches ? 'dark' : 'light';
    if (next === system) {
      delete root.dataset.theme;
      try {
        localStorage.removeItem('feeder-theme');
      } catch {
        /* storage unavailable */
      }
    } else {
      root.dataset.theme = next;
      try {
        localStorage.setItem('feeder-theme', next);
      } catch {
        /* storage unavailable */
      }
    }
    syncThemeControl();
  });

  // Copy prompt button
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.dataset.done = '';
        setTimeout(() => delete btn.dataset.done, 1400);
      } catch {
        /* clipboard blocked */
      }
    });
  }

  // Optional latest release version label
  const versionEl = document.getElementById('version');
  if (versionEl) {
    fetch('https://api.github.com/repos/mattjmdesign/feeder/releases/latest')
      .then((res) => (res.ok ? res.json() : null))
      .then((release: { tag_name?: string } | null) => {
        if (release?.tag_name) {
          versionEl.textContent = `v${release.tag_name.replace(/^v/, '')} for Apple silicon Macs (M1 or later, arm64)`;
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .page {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: 22px clamp(16px, 4vw, 32px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--fs-body);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .brand__orb {
    width: 19px;
    height: 19px;
    border-radius: 50%;
    box-shadow: var(--orb-ring);
  }

  .top__right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .top__link {
    color: var(--text-2);
    font-size: var(--fs-body);
    transition: color 0.16s ease;
  }

  .top__link:hover {
    color: var(--text);
  }

  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.16s ease,
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.14s var(--ease);
  }

  .theme-btn:hover {
    color: var(--text);
    background: var(--hover-tint);
  }

  .theme-btn:active {
    transform: scale(0.94);
  }

  .theme-btn :global(.theme-icon) {
    grid-area: 1 / 1;
  }

  .theme-btn :global(.theme-icon--sun) {
    display: none;
  }

  .theme-btn :global(.theme-icon--moon) {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-btn :global(.theme-icon--sun) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-btn :global(.theme-icon--moon) {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .theme-btn :global(.theme-icon--sun) {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme-btn :global(.theme-icon--moon) {
    display: none;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(28px, 6vh, 60px) 16px 0;
    text-align: center;
  }

  /* Crisp glass orb on its own — grounded physical shadow, no outer glow */
  .orb {
    --size: clamp(118px, 16vw, 146px);
    position: relative;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: transform 0.24s var(--ease);
  }

  .orb__ball {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: var(--orb-ring), var(--orb-drop);
  }

  .orb:hover {
    transform: scale(1.03);
  }

  .orb:active {
    transform: scale(0.96);
  }

  .orb.is-new {
    animation: orb-pop 0.36s var(--ease);
  }

  @keyframes orb-pop {
    0% {
      scale: 0.9;
    }
    55% {
      scale: 1.04;
    }
    100% {
      scale: 1;
    }
  }

  h1 {
    margin: 28px 0 0;
    max-width: 18em;
    font-size: var(--fs-1);
    font-weight: 500;
    letter-spacing: -0.036em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .lede {
    max-width: 43em;
    margin: 18px 0 0;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .lede a,
  .section a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-underline-offset: 3px;
  }

  .lede a:hover,
  .section a:hover {
    text-decoration-color: var(--text);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }

  .cta__main,
  .cta__alt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: var(--fs-body);
    font-weight: 500;
    letter-spacing: -0.01em;
    transition:
      background 0.16s ease,
      border-color 0.16s ease,
      transform 0.14s var(--ease);
  }

  .cta__main {
    background: var(--btn-bg);
    color: var(--btn-ink);
  }

  .cta__main:hover {
    background: var(--btn-bg-hover);
  }

  .cta__alt {
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--text);
  }

  .cta__alt:hover {
    background: var(--hover-tint);
  }

  .cta__main:active,
  .cta__alt:active {
    transform: scale(0.97);
  }

  .meta {
    margin: 14px 0 0;
    color: var(--text-3);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }

  .demo {
    width: min(100%, 1040px);
    margin: clamp(44px, 7vh, 72px) auto 0;
    padding: 0 16px;
  }

  .demo + .demo {
    margin-top: clamp(56px, 9vh, 88px);
  }

  .demo__slot {
    mask-image: linear-gradient(to bottom, #000 76%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 76%, transparent);
  }

  .demo__slot--home {
    aspect-ratio: 960 / 440;
  }

  .demo__slot--feed {
    aspect-ratio: 960 / 540;
  }

  @media (max-width: 751px) {
    .demo__slot--home {
      aspect-ratio: 358 / 330;
    }

    .demo__slot--feed {
      aspect-ratio: 358 / 340;
    }
  }

  .demo__caption strong {
    color: var(--text);
    font-weight: 500;
  }

  .demo__caption {
    max-width: 38em;
    margin: 14px auto 0;
    color: var(--text-3);
    font-size: var(--fs-sm);
    line-height: 1.55;
    text-align: center;
  }

  .section {
    width: min(100% - 32px, 920px);
    margin: clamp(72px, 10vh, 104px) auto 0;
    scroll-margin-top: 28px;
  }

  .section__title {
    margin: 0 0 24px;
    font-size: var(--fs-2);
    font-weight: 500;
    letter-spacing: -0.028em;
  }

  .section h3 {
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .section p,
  .specs dd {
    margin: 7px 0 0;
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .section strong {
    color: var(--text);
    font-weight: 500;
  }

  .section code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--surface-subtle);
    color: var(--text);
  }

  .feature__text {
    max-width: 40em;
  }

  .feature__pic {
    margin-top: 28px;
    mask-image: linear-gradient(to bottom, #000 80%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent);
  }

  .feature__pic--mcp {
    aspect-ratio: 960 / 420;
  }

  .feature__pic--notebook {
    aspect-ratio: 960 / 440;
  }

  @media (max-width: 751px) {
    .feature__pic--mcp {
      aspect-ratio: 358 / 470;
    }

    .feature__pic--notebook {
      aspect-ratio: 358 / 440;
    }
  }

  .calls {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 24px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .calls li {
    display: grid;
    gap: 4px;
  }

  .calls code {
    justify-self: start;
    font-size: var(--fs-sm);
  }

  .calls span {
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  @media (max-width: 760px) {
    .calls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tile__pic--menu {
    aspect-ratio: 320 / 260;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--surface-subtle);
  }

  .tile--wide {
    grid-column: span 2;
  }

  .tile .tile__copy {
    margin: 0;
    padding: 22px 24px 0;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.45;
    text-wrap: pretty;
  }

  .tile__copy strong {
    color: var(--text);
    font-weight: 500;
  }

  .tile__pic {
    aspect-ratio: 320 / 240;
    margin-top: auto;
  }

  .tile__pic--reply {
    aspect-ratio: 620 / 340;
  }

  .tile--statement {
    gap: 8px;
    padding: 22px 24px 24px;
    color: var(--text);
  }

  .file {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .file__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--surface-subtle);
    color: var(--text);
  }

  .file__lines {
    display: grid;
    gap: 2px;
  }

  .file__name {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .file__where {
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  .tile--statement .statement {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-2);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .tile--statement .tile__copy {
    padding: 0;
    font-size: var(--fs-body);
  }

  .tools {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-content: center;
    gap: 10px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }

  .tools li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--surface);
