---
import '@fontsource-variable/inter';
import { SITE_URL, asset } from '../lib/site';
import '../styles/global.css';

const title = 'Feeder';
const description =
  'A local Mac app where your coding agents leave short updates on what they did, why, and what’s next. Built in Rust on Rune. Nothing leaves your Mac.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/png" href={asset('assets/favicon.png')} />
    <link rel="canonical" href={SITE_URL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE_URL}assets/home-dark.png`} />
  </head>
  <body>
    <slot />
  </body>
</html>
