<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Feeder: third-party licenses</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 13px/1.5 -apple-system, sans-serif; max-width: 760px; margin: 32px auto; padding: 0 16px; }
  h1 { font-size: 20px; font-weight: 500; }
  h2 { font-size: 15px; font-weight: 500; margin-top: 32px; }
  pre { white-space: pre-wrap; font: 11px/1.45 ui-monospace, monospace; padding: 12px; border-radius: 8px; background: rgba(127,127,127,.1); }
  li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Feeder is open source under the MIT License and is built on the open-source software below.</p>
{{#each licenses}}
<h2>{{name}}</h2>
<p>Used by:</p>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
<!-- sparkle -->
</body>
</html>
